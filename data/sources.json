      "use": [
        "flood",
        "landslide",
        "coastal_hazard",
        "ecological_siting_constraints"
      ],
      "note": "KSDMA publishes flood probability rasters and GSI landslide-susceptibility shapefiles suitable for explicit exclusion and stress-test layers."
    },
    "bhuvan": {
      "priority": "P1",
      "organisation": "NRSC/ISRO Bhuvan",
      "home": "https://bhuvan.nrsc.gov.in/",
      "acquisition": "portal_download",
      "use": [
        "lulc",
        "dem",
        "water",
        "geomorphology",
        "spatial_constraints"
      ],
      "note": "Large GIS layers are catalogued separately from the lightweight web bundle."
